#
# Editors
#

export EDITOR='vim'
export VISUAL='vim'
export PAGER='less'

export DOTFILES="$HOME/.dotfiles"

# Set the list of directories that Zsh searches for programs.
path=(
    $HOME/bin2
    $HOME/.local/bin
    $HOME/.dotfiles/bin
    /opt/local/{bin,sbin}
    /usr/local/{bin,sbin}
    $path
)

# XDG Base Directory Spec env vars as per freedesktop.org project
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"

#
# Less
#

# Set the default Less options.
# Mouse-wheel scrolling has been disabled by -X (disable screen clearing).
# Remove -X and -F (exit if the content fits on one screen) to enable it.
export LESS="-g -i -M -R -S -w -z-4"

# pyenv
# export PYTHON_BUILD_MIRROR_URL=https://jedore.netlify.app/tools/python-mirrors/
if [[ -d $HOME/.pyenv ]]; then
    export PYENV_ROOT="$HOME/.pyenv"
    export PATH="$PYENV_ROOT/bin:$PATH"
    if command -v pyenv 1>/dev/null 2>&1; then
        eval "$(pyenv init --path)"
        # Redirecting rvm init to /dev/null to avoid dirty output in non-interactive shells.
        eval "$(pyenv virtualenv-init -)" >/dev/null 2>&1
    fi
fi

# java (jenv)
if [[ -d $HOME/.jenv ]]; then
    export PATH="$HOME/.jenv/bin:$PATH"
    eval "$(jenv init -)"
fi

# maven
export PATH="$HOME/bin2/maven/bin:$PATH"

#nodejs
export NODE_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/nodejs-release/
# fnm
export FNM_NODE_DIST_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/nodejs-release/
if [[ -d "$HOME/.fnm" ]]; then
    export PATH="$HOME/.fnm:$PATH"
    eval "$(fnm env --use-on-cd --shell zsh)"
fi

# rust
if [[ -e "$HOME/.cargo/env" ]]; then
    . "$HOME/.cargo/env"
fi

export RUSTUP_UPDATE_ROOT=https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup
export RUSTUP_DIST_SERVER=https://mirrors.tuna.tsinghua.edu.cn/rustup

export _ZO_FZF_OPTS='--color=fg:-1,fg+:#ffffff,bg:-1,bg+:#3c4048 --color=hl:#5ea1ff,hl+:#5ef1ff,info:#ffbd5e,marker:#5eff6c --color=prompt:#ff5ef1,spinner:#bd5eff,pointer:#ff5ea0,header:#5eff6c --color=gutter:-1,border:#3c4048,scrollbar:#7b8496,label:#7b8496 --color=query:#ffffff --border="rounded" --border-label="" --preview-window="hidden" --height 40%'

export HOMEBREW_BREW_GIT_REMOTE="https://mirrors.tuna.tsinghua.edu.cn/git/homebrew/brew.git"
export HOMEBREW_API_DOMAIN="https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles/api"
export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles"
