# ==============================================================================
# 🚀 Zsh Extreme Configuration (Zero-Delay Ready)
# Optimized with zsh-defer and antidote
# ==============================================================================

# Fast-path for non-interactive shells
[[ "$TERMINAL_CONTEXT" == "non-interactive" ]] && return

# --- 📂 Paths & Globals
typeset -U path fpath # Ensure unique paths
export DOTFILES="$HOME/.dotfiles"

# Docker CLI completions (Must be before compinit)
[[ -d "$HOME/.docker/completions" ]] && fpath=("$HOME/.docker/completions" $fpath)
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"

# ---(Compinit) ---
# Faster compinit: only runs if the dump file is older than 24h
autoload -Uz compinit
zsh_defer_compinit() {
  local dump="$HOME/.zcompdump"
  if [[ -s "$dump" && (! "$dump" -nt "${ZDOTDIR:-$HOME}/.zshrc" || "$(date +%j)" != "$(date -r "$dump" +%j)") ]]; then
    compinit -d "$dump"
  else
    compinit -C -d "$dump"
  fi
}
# Dummy compdef to prevent errors before compinit runs
compdef() { }

# --- 📦 Antidote (Plugin Manager) ---
ANTIDOTE_DIR="$XDG_DATA_HOME/antidote"
[[ ! -d "$ANTIDOTE_DIR" ]] && git clone --depth=1 https://github.com/mattmc3/antidote.git "$ANTIDOTE_DIR"
source "$ANTIDOTE_DIR/antidote.zsh"

# Compile plugins.txt into a static .zsh file
ANTIDOTE_PLUGINS_TXT="$DOTFILES/config/zsh/common/plugins.txt"
ANTIDOTE_PLUGINS_ZSH="$XDG_CACHE_HOME/antidote/plugins.zsh"

if [[ ! "$ANTIDOTE_PLUGINS_ZSH" -nt "$ANTIDOTE_PLUGINS_TXT" ]]; then
    mkdir -p "$(dirname "$ANTIDOTE_PLUGINS_ZSH")"
    antidote bundle < "$ANTIDOTE_PLUGINS_TXT" > "$ANTIDOTE_PLUGINS_ZSH"
fi

# Keybindings & Plugin Hooks
# Note: jeffreytse/zsh-vi-mode handles core keybindings.
# Custom bindings must be inside hooks for robustness.

# 1. After core ZVM initialization (handles Insert/Emacs mode)
function zvm_after_init() {
  # --- 🔍 History Substring Search (Arrows) ---
  zvm_bindkey viins '^[[A' atuin-up-search
  zvm_bindkey viins '^[[B' atuin-up-search
}

# 2. After lazy keybindings (handles Normal/Visual mode)
function zvm_after_lazy_keybindings() {
  # History Substring Search (Vim keys)
  zvm_bindkey vicmd 'k' atuin-up-search
  zvm_bindkey vicmd 'j' atuin-up-search
}

source "$ANTIDOTE_PLUGINS_ZSH"

# --- 🛠️ Core Environment (Immediate Load) ---
[[ -f ~/.env.zsh ]] && source ~/.env.zsh

# Mise (Multi-language version manager: Load EARLY for tool availability)
if command -v mise >/dev/null; then
    eval "$(mise activate zsh)"
fi

# Load aliases after mise is activated (so mise-managed tools like trash-put are available)
[[ -f ~/.aliases ]] && source ~/.aliases

# Load custom shell functions (Source directly from DOTFILES if symlink fails)
for func in "$DOTFILES/config/zsh/functions"/*.zsh; do
    [[ -r "$func" ]] && source "$func"
done
unset func

# Machine-specific secrets/configs
for secret in ~/.{zsh_secret,localrc}; do
    [[ -r "$secret" ]] && source "$secret"
done
unset secret

# --- 🔧 Helpers (Smart Loading) ---

# Execute a command/function, deferred if zsh-defer is available
_run_deferred() {
    if command -v zsh-defer >/dev/null 2>&1; then
        zsh-defer "$@"
    else
        # If it's -c "cmd", eval the cmd. Otherwise run the function/command.
        if [[ "$1" == "-c" ]]; then
            eval "$2"
        else
            "$@"
        fi
    fi
}

# Load a tool via its init command, deferred if possible
_load_tool() {
    local cmd="$1"
    local init_cmd="$2"
    _run_deferred -c "command -v $cmd >/dev/null && eval \"\$($init_cmd)\""
}

# Simple fallback prompt while heavy one loads
PROMPT='%F{blue}%n%f@%F{green}%m%f %F{cyan}%1~%f %# '

# --- 🚀 Tool Initializations (Flattened) ---

# SSH Check: Don't load fancy prompt if on SSH
if [[ -n "$SSH_CONNECTION" ]]; then
    PROMPT='%F{yellow}%n@%m%f %F{cyan}%1~%f %# '
else
    _load_tool "oh-my-posh" "oh-my-posh init zsh --config \"$DOTFILES/config/oh-my-posh/custom.omp.json\""
fi

# FZF-Tab (MUST be after compinit)
_run_deferred zsh_defer_compinit
_run_deferred source "$DOTFILES/config/fzf/.fzf.zsh"

_load_tool "zoxide" "zoxide init zsh"
_load_tool "atuin" "atuin init zsh --disable-up-arrow"
_load_tool "pay-respects" "pay-respects zsh --alias fuck"

# --- ⚙️ Zsh Options & Settings ---
# History
setopt NO_BEEP              # Shhh.
setopt INTERACTIVE_COMMENTS # Allow comments in interactive shell
setopt NOTIFY               # Report the status of background jobs immediately
setopt NO_HUP               # Don't kill background jobs when logout
setopt CORRECT              # Suggest corrections for misspelled commands

setopt EXTENDED_HISTORY          # Write the history file in the ':start:elapsed;command' format.
setopt SHARE_HISTORY             # Share history between all sessions.
setopt APPEND_HISTORY            # Append to history file, don't overwrite.
setopt INC_APPEND_HISTORY        # Write to history file immediately, not just on exit.
setopt HIST_EXPIRE_DUPS_FIRST    # Expire duplicate entries first when trimming history.
setopt HIST_IGNORE_DUPS          # Don't record an entry that was just recorded.
setopt HIST_IGNORE_ALL_DUPS      # Delete old recorded entry if new entry is a duplicate.
setopt HIST_FIND_NO_DUPS         # Do not display a line previously found.
setopt HIST_IGNORE_SPACE         # Don't record an entry starting with a space.
setopt HIST_SAVE_NO_DUPS         # Don't write duplicate entries in the history file.
setopt HIST_REDUCE_BLANKS        # Remove superfluous blanks from each command line.
setopt HIST_VERIFY               # Don't execute immediately upon history expansion.

# Navigation & UI
setopt AUTO_CD              # Go to directory by just typing its name
setopt AUTO_PUSHD           # Push the old directory onto the stack
setopt PUSHD_IGNORE_DUPS    # Do not store duplicates in the stack
setopt EXTENDED_GLOB        # Use extended globbing features
setopt NO_BEEP              # Shhh.
setopt INTERACTIVE_COMMENTS # Allow comments in interactive shell

