# ==============================================================================
# 🚀 Zsh Extreme Configuration (Zero-Delay Ready)
# Optimized with zsh-defer and antidote
# ==============================================================================

# Fast-path for non-interactive shells
[[ "$TERMINAL_CONTEXT" == "non-interactive" ]] && return

# --- 📂 Paths & Globals
typeset -U path fpath # Ensure unique paths
export DOTFILES="$HOME/.dotfiles"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"

# ---(Compinit) ---
# MUST be loaded before plugins that use compdef
autoload -Uz compinit
# Dummy compdef to prevent errors before compinit runs
compdef() { }

# Deferred compinit for performance
zsh_defer_compinit() {
  if [[ -n "$HOME/.zcompdump"(N.m-1) ]]; then
    compinit -C -d "$HOME/.zcompdump"
  else
    compinit -d "$HOME/.zcompdump"
  fi
}

# --- 📦 Antidote (Plugin Manager) ---
ANTIDOTE_DIR="$XDG_DATA_HOME/antidote"
[[ ! -d "$ANTIDOTE_DIR" ]] && git clone --depth=1 https://github.com/mattmc3/antidote.git "$ANTIDOTE_DIR"
source "$ANTIDOTE_DIR/antidote.zsh"

# Compile plugins.txt into a static .zsh file
ANTIDOTE_PLUGINS_TXT="$DOTFILES/config/zsh/common/plugins.txt"
ANTIDOTE_PLUGINS_ZSH="$XDG_CACHE_HOME/antidote/plugins.zsh"

if [[ ! "$ANTIDOTE_PLUGINS_ZSH" -nt "$ANTIDOTE_PLUGINS_TXT" ]]; then
    mkdir -p "$(dirname "$ANTIDOTE_PLUGINS_ZSH")"
    antidote bundle < "$ANTIDOTE_PLUGINS_TXT" > "$ANTIDOTE_PLUGINS_ZSH"
fi
source "$ANTIDOTE_PLUGINS_ZSH"

# --- 🛠️ Core Environment (Immediate Load) ---
[[ -f ~/.env ]] && source ~/.env
[[ -f ~/.aliases ]] && source ~/.aliases

# Load custom shell functions
if [[ -d ~/.zsh_functions ]]; then
    for func in ~/.zsh_functions/*.zsh; do
        [[ -r "$func" ]] && source "$func"
    done
    unset func
fi

# Machine-specific secrets/configs
for secret in ~/.{zsh_secret,localrc}; do
    [[ -r "$secret" ]] && source "$secret"
done
unset secret

# --- 🔧 Tool Initializations (DEFERRED for zero delay) ---

# Helper: Load a tool if it exists, deferred if zsh-defer is available
_load_tool() {
    local cmd="$1"
    local init_cmd="$2"
    if command -v "$cmd" >/dev/null 2>&1; then
        if command -v zsh-defer >/dev/null 2>&1; then
            zsh-defer -c "eval \"\$($init_cmd)\""
        else
            eval "$($init_cmd)"
        fi
    fi
}

# Simple fallback prompt while heavy one loads
PROMPT='%F{blue}%n%f@%F{green}%m%f %F{cyan}%1~%f %# '

# Deferred tools
if command -v zsh-defer >/dev/null; then
    # Deferred compinit
    zsh-defer zsh_defer_compinit

    # Oh My Posh (Prompt) - Deferred load
    if command -v oh-my-posh >/dev/null; then
        zsh-defer -c "eval \"\$(oh-my-posh init zsh --config \"$DOTFILES/config/oh-my-posh/custom.omp.json\")\""
    fi

    # Tools with standard init commands
    _load_tool "zoxide" "zoxide init zsh"
    _load_tool "atuin" "atuin init zsh --disable-up-arrow"

    # FZF
    zsh-defer source "$DOTFILES/config/fzf/.fzf.zsh"

    # Python (Pyenv)
    zsh-defer -c '
        if [[ -d "$HOME/.pyenv" ]]; then
            export PYENV_ROOT="$HOME/.pyenv"
            path=("$PYENV_ROOT/bin" $path)
            eval "$(pyenv init - zsh)"
            eval "$(pyenv virtualenv-init -)" >/dev/null 2>&1
        fi
    '

    # Java (jenv)
    zsh-defer -c '[[ -d "$HOME/.jenv" ]] && path=("$HOME/.jenv/bin" $path) && eval "$(jenv init -)"'

    # Rust
    zsh-defer -c '[[ -e "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"'

    # Custom completions & options that can be deferred
    zsh-defer -c '
        zstyle ":completion:*" list-colors "${(s.:.)LS_COLORS}"
        zstyle ":fzf-tab:*" fzf-command ftb-tmux-popup
    '
else
    # Fallback if zsh-defer is not available
    [[ -f "$DOTFILES/config/fzf/.fzf.zsh" ]] && source "$DOTFILES/config/fzf/.fzf.zsh"
    command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
    command -v atuin >/dev/null && eval "$(atuin init zsh --disable-up-arrow)"
    [[ -d "$HOME/.pyenv" ]] && export PYENV_ROOT="$HOME/.pyenv" && path=("$PYENV_ROOT/bin" $path) && eval "$(pyenv init - zsh)"
    [[ -d "$HOME/.jenv" ]] && path=("$HOME/.jenv/bin" $path) && eval "$(jenv init -)"
    [[ -d "$HOME/.fnm" ]] && path=("$HOME/.fnm" $path) && eval "$(fnm env --use-on-cd --shell zsh)"
    [[ -e "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"
fi

# --- ⚙️ Zsh Options & Settings ---
setopt AUTO_CD              # Go to directory by just typing its name
setopt AUTO_PUSHD           # Push the old directory onto the stack
setopt PUSHD_IGNORE_DUPS    # Do not store duplicates in the stack
setopt SHARE_HISTORY        # Share history between all sessions
setopt HIST_IGNORE_ALL_DUPS # Delete old recorded entry if new entry is a duplicate
setopt HIST_REDUCE_BLANKS   # Remove superfluous blanks from each command line
setopt EXTENDED_GLOB        # Use extended globbing features
setopt NO_BEEP              # Shhh.

# Keybindings
bindkey -e                  # Use emacs keybindings
bindkey "^[[A" history-beginning-search-backward
bindkey "^[[B" history-beginning-search-forward

