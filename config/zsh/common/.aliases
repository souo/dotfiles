# ==============================================================================
# 🐚 Shell Aliases
# ==============================================================================

# --- 🚀 Core Replacements ---
command -v nvim >/dev/null && alias vim='nvim' && alias v='nvim'
command -v btm >/dev/null && alias top='btm'
command -v tokei >/dev/null && alias loc='tokei'
alias vsc='code .'

# --- 📁 Navigation ---
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ~='cd ~'
alias d='cd ~/Downloads'
alias p='cd ~/Projects'
alias dotfiles="cd $DOTFILES"

# --- 🛡️ Safe Operations ---
# Unify trash tool aliases to 'tp'
if command -v trash-put >/dev/null; then
    alias tp='trash-put' tl='trash-list' tr='trash-restore' te='trash-empty'
elif command -v trash >/dev/null; then
    # macOS 'trash' (Homebrew)
    alias tp='trash'
elif [[ -x "$DOTFILES/bin/trash.sh" ]]; then
    alias tp="$DOTFILES/bin/trash.sh"
fi

# Redefine rm as a warning function if tp is available
if alias tp >/dev/null 2>&1; then
    _rm_warning() {
        local msg=$'[bold red]🛡️ 危险操作！[/]\n请使用 [bold green]tp[/] (trash-put) 或 [bold yellow]\\rm[/] (原始命令)。'
        if command -v rich >/dev/null; then
            rich --print "$msg"
        elif command -v python3 >/dev/null && python3 -c "import rich" 2>/dev/null; then
            python3 -c "import sys; from rich.console import Console; Console().print(sys.argv[1])" "$msg"
        else
            printf "🛡️ 危险操作！\n请使用 \"tp\" (trash-put) 或 \"\\\\rm\" (原始命令)。\n"
        fi
        return 1
    }
    alias rm='_rm_warning'
else
    # Fallback to interactive rm as a last resort if no trash tools are available
    alias rm='rm -i'
fi

alias cp='cp -i'
alias mv='mv -i'

# --- 🛠️ Modern CLI Tools ---

# Eza (ls replacement)
if command -v eza >/dev/null; then
    alias ls='eza --icons --group-directories-first'
    alias ll='eza -lh --icons --group-directories-first'
    alias la='eza -a --icons --group-directories-first'
    alias lt='eza --tree --icons --level=2'
    alias llt='eza -lh --tree --icons --level=2'
fi

# Bat (cat replacement)
if command -v batcat >/dev/null; then
    alias bat='batcat'
    alias cat='batcat -p'
elif command -v bat >/dev/null; then
    alias cat='bat -p'
fi

# FD-find (Ubuntu/Debian fix)
if command -v fdfind >/dev/null; then
    alias fd='fdfind'
fi

# Zellij
command -v zellij >/dev/null && alias vibe='zellij --layout vibe'

# Modern Replacements
command -v xh >/dev/null && alias http='xh'
command -v sd >/dev/null && alias sed-smart='sd'

# Lazygit
command -v lazygit >/dev/null && alias lg='lazygit'

# Yazi (using our custom yy function)
command -v yazi >/dev/null && alias y='yy'

# FZF Search Aliases
alias f='fp'      # Fuzzy File Search
# fz is now a function in fzf.zsh
alias fk='fkill'  # Fuzzy Kill
alias dot='fconf' # Fuzzy Dotfiles Config

# --- 🐍 Python ---
alias py='python3'
alias venv='python3 -m venv venv && source venv/bin/activate'

# --- 🚀 App Specific ---
alias claude-mem='bun "/Users/2z/.claude/plugins/cache/thedotmack/claude-mem/10.5.6/scripts/worker-service.cjs"'
