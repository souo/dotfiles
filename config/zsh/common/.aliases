# ==============================================================================
# 🐚 Shell Aliases
# ==============================================================================

# --- 🚀 Core Replacements ---
command -v nvim >/dev/null && alias vim='nvim' && alias v='nvim'
command -v btm >/dev/null && alias top='btm'
command -v tokei >/dev/null && alias loc='tokei'
alias vsc='code .'

# --- 📁 Navigation ---
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ~='cd ~'
alias d='cd ~/Downloads'
alias p='cd ~/Projects'
alias dotfiles="cd $DOTFILES"

# --- 📦 Git (Modern & Minimal) ---
alias g='git'
alias gst='git status'
alias gp='git push'
alias gl='git pull'
alias gco='git checkout'
alias gb='git branch'
alias gd='git diff'
alias gcm='git commit -m'
alias gaa='git add --all'
alias glog="git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"

# --- 🛡️ Safe Operations ---
# Unify trash tool aliases to 'tp'
if command -v trash-put >/dev/null; then
    alias tp='trash-put' tl='trash-list' tr='trash-restore' te='trash-empty'
elif command -v trash >/dev/null; then
    # macOS 'trash' (Homebrew)
    alias tp='trash'
elif [[ -x "$DOTFILES/bin/trash.sh" ]]; then
    alias tp="$DOTFILES/bin/trash.sh"
fi

alias cp='cp -i'
alias mv='mv -i'

# --- 🛠️ Modern CLI Tools ---

# Eza (ls replacement) - Optimized & Enhanced
if command -v eza >/dev/null; then
    # Shared base parameters: Icons, directories first, and terminal hyperlinks
    local eza_params='--icons --group-directories-first --hyperlink'

    alias ls="eza $eza_params"
    alias ll="eza -lh --git $eza_params"
    alias la="eza -lah --git $eza_params"
    alias lt="eza --tree --level=2 $eza_params"
    alias llt="eza -lh --tree --level=2 $eza_params"

    # Specialty Views (Inherited from OMZ plugin)
    alias ldot="eza -ld .* $eza_params"          # List only hidden files (dots)
    alias lD="eza -lD $eza_params"               # List only directories
    alias lS="eza -1lh -ssize $eza_params"       # Sort by size (largest first)
    alias lT="eza -1lh -smodified $eza_params"   # Sort by time (newest first)
fi

# Bat (cat replacement)
if command -v batcat >/dev/null; then
    alias bat='batcat'
    alias cat='batcat -p'
elif command -v bat >/dev/null; then
    alias cat='bat -p'
fi

# FD-find (Ubuntu/Debian fix)
if command -v fdfind >/dev/null; then
    alias fd='fdfind'
fi

# Zellij
command -v zellij >/dev/null && alias vibe='zellij --layout vibe'

# Modern Replacements
command -v xh >/dev/null && alias http='xh'
command -v sd >/dev/null && alias sed-smart='sd'

# Lazygit
command -v lazygit >/dev/null && alias lg='lazygit'

# Yazi (using our custom yy function)
command -v yazi >/dev/null && alias y='yy'

# FZF Search Aliases
alias f='fp'      # Fuzzy File Search
# fz is now a function in fzf.zsh
alias fk='fkill'  # Fuzzy Kill
alias dot='fconf' # Fuzzy Dotfiles Config

# --- 🐍 Python ---
alias py='python3'
alias venv='python3 -m venv venv && source venv/bin/activate'

# --- 🚀 App Specific ---
alias claude-mem='bun "/Users/2z/.claude/plugins/cache/thedotmack/claude-mem/10.5.6/scripts/worker-service.cjs"'
