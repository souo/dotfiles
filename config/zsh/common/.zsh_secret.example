# 🤫 Personal Secret Tokens & Private Configs
# This file should be copied to ~/.zsh_secret
# It is NOT tracked by Git.

# --- Examples ---

# GitHub Token (for homebrew or other CLI tools)
# export HOMEBREW_GITHUB_API_TOKEN="your_token_here"

# OpenAI / Anthropic API Keys
# export OPENAI_API_KEY="sk-..."
# export ANTHROPIC_API_KEY="sk-ant-..."

# NPM / Cargo Registry Tokens
# export NPM_TOKEN="..."

# Machine-specific environment overrides
# export WORK_EMAIL="user@company.com"
