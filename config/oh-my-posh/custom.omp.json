{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "streaming": 100,
  "palette": {
    "blue": "#00C5C7",
    "green": "#33FF57",
    "os": "#ACB0BE",
    "pink": "#F4B8E4",
    "red": "#FF5733"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "style": "plain",
          "template": "{{.Icon}} ",
          "foreground": "p:os",
          "type": "os"
        },
        {
          "options": {
            "folder_icon": "..\ue5fe..",
            "home_icon": "~",
            "style": "agnoster_short"
          },
          "style": "plain",
          "template": "{{ .Path }} ",
          "foreground": "p:blue",
          "type": "path"
        },
        {
          "foreground": "#6C6C6C",
          "options": {
            "branch_icon": "\ue725 ",
            "branch_ahead_icon": "<#FF0000>\u2191 </>",
            "branch_behind_icon": "<#00FFD0>\u2193 </>",
            "fetch_status": true,
            "github_icon": ""
          },
          "style": "plain",
          "template": "{{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}<#FFAFD7>*</>{{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "type": "git"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "options": {
            "threshold": 10
          },
          "style": "plain",
          "template": "took \uf252 {{ .FormattedMs }} ",
          "foreground": "#bab02a",
          "type": "executiontime"
        },
        {
          "options": {
            "time_format": "15:04:05"
          },
          "style": "plain",
          "template": " {{ .CurrentDate | date .Format }} \uf017 ",
          "foreground": "#00C5C7",
          "type": "time"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "options": {
            "always_enabled": true
          },
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "template": "❯",
          "foreground": "#33FF57",
          "background": "#29315A",
          "type": "status",
          "foreground_templates": [
            "{{ if .Error }}#FF5733{{ end }}"
          ]
        }
      ],
      "newline": true
    }
  ],
  "version": 3,
  "final_space": true
}
