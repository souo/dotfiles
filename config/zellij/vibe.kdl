layout{
    tab name="Qwen" focus=true hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane command="qwen"
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="Agy" hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane command="agy"
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="Review" hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane command="lazygit"
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="Terminal" hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane focus=true
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    new_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
}
